# Copy this file to `.env` and adjust. Every value has a safe default for local development.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# When hosted, e.g. DJANGO_ALLOWED_HOSTS=ekansh.pythonanywhere.com and
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ekansh.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database: SQLite by default (zero setup). For PostgreSQL use e.g.
# DATABASE_URL=postgres://user:password@localhost:5432/brightloop
DATABASE_URL=

# Email. Each key must appear only once in .env: if a key is repeated, the LAST line wins.
#   outbox  (default) emails are stored in the database and shown under "Email outbox"
#           (admin menu) and printed in the terminal. Works offline; best for demos.
#   console only printed in the terminal.
#   smtp    real delivery. Brevo: Brevo -> SMTP & API -> SMTP tab; the password is an SMTP key
#           (xsmtpsib-...), not the API key (xkeysib-...); the user is the "Login" shown there
#           (e.g. 8a1b2c001@smtp-brevo.com); the From address must be a sender verified in Brevo.
#           Test with: python manage.py sendtestemail you@example.com
EMAIL_BACKEND=outbox
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="Brightloop Billing <billing@brightloop.local>"

# Branding
APP_NAME=Brightloop
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR
TIME_ZONE=Asia/Kolkata
