# Copy this file to `.env` and adjust. Every value has a safe default for local development.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: SQLite by default (zero setup). For PostgreSQL use e.g.
# DATABASE_URL=postgres://user:password@localhost:5432/brightloop
DATABASE_URL=

# Email: "console" prints emails (password-reset links, invoices) to the terminal
# and needs no internet. Use "smtp" with the EMAIL_* settings for real delivery.
# Brevo example (Brevo -> SMTP & API -> SMTP tab):
#   EMAIL_BACKEND=smtp
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=<the "Login" shown on that tab, e.g. 8a1b2c001@smtp-brevo.com>
#   EMAIL_HOST_PASSWORD=<an SMTP key (xsmtpsib-...), not the API key (xkeysib-...)>
#   DEFAULT_FROM_EMAIL=Brightloop Billing <a sender verified in Brevo>
# Test it with: python manage.py sendtestemail you@example.com
EMAIL_BACKEND=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=billing@brightloop.local

# Branding
APP_NAME=Brightloop
CURRENCY_SYMBOL=₹
CURRENCY_CODE=INR
TIME_ZONE=Asia/Kolkata
